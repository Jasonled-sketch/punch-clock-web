# ===== 必填 =====
BASE_URL=https://你的服務.up.railway.app      # 對外網址（LINE 抓圖、相簿連結都靠它）
ALBUM_TOKEN=自己取一串長一點的通行碼            # 相簿通行碼，也是 LINE「綁定」用的密碼
DATA_DIR=/data                                # Railway Volume 掛載點（沒掛 Volume 重新部署會清空）

# ===== LINE（Messaging API）=====
LINE_TOKEN=
LINE_SECRET=
# FAMILY_GROUP_ID=        # 不填＝用第一個綁定的群組
# RECAP_MONTHLY_AT=1 20:00  # 每月幾號幾點自動推上個月回顧

# ===== AI 照片註記（Claude）=====
ANTHROPIC_API_KEY=
# ALBUM_AI_MODEL=claude-opus-5-5   # 想省錢可改 claude-haiku-5-5（見 README 費用）
# ALBUM_AI_EFFORT=low

# ===== Google 雲端硬碟（選填）=====
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DRIVE_BACKUP=1          # 把 LINE 收到的原檔備份一份到雲端硬碟

# ===== 微調（通常不用動）=====
# FACE_MATCH_THRESHOLD=0.42   # 認臉嚴格度，越小越嚴格
# RECAP_MAX_PHOTOS=36
# DISPLAY_SIZE=1280
