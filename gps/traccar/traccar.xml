<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>

    <entry key='config.default'>./conf/default.xml</entry>

    <!-- ══ 轉發到本專案的接收服務 ══
         這三行是整個串接的關鍵。type 一定要 json，
         預設是 url（query string 形式），我們的服務讀不到。 -->
    <entry key='forward.enable'>true</entry>
    <entry key='forward.url'>https://換成你的服務網址/traccar/position</entry>
    <entry key='forward.type'>json</entry>

    <!-- Traccar 的轉發不帶簽章，沒有這個 header 等於誰知道網址都能灌假座標。
         冒號後面那串要跟服務的 TRACCAR_INGEST_TOKEN 一模一樣。 -->
    <entry key='forward.header'>X-Ingest-Token: 換成一組夠長的隨機密碼</entry>

    <!-- 轉發失敗時重試，避免服務短暫重啟就掉資料 -->
    <entry key='forward.retry.enable'>true</entry>
    <entry key='forward.retry.delay'>5000</entry>
    <entry key='forward.retry.count'>10</entry>

    <!-- ══ 過濾垃圾點 ══
         少送一點噪音給下游。我們的轉接層也會再擋一次（valid=false、0,0），
         這裡先擋掉可以省流量也省 log。 -->
    <entry key='filter.enable'>true</entry>
    <entry key='filter.invalid'>true</entry>
    <entry key='filter.zero'>true</entry>
    <entry key='filter.duplicate'>true</entry>
    <entry key='filter.future'>86400</entry>

    <!-- ══ 資料庫 ══
         H2 檔案式，夠一般車隊用。路徑必須落在有掛載的 volume 上，
         否則容器一重啟，裝置設定和歷史軌跡全部消失。 -->
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>

    <!-- ══ 只開要用的協定埠 ══
         GT06 走 5023。其他兩千多種協定的埠沒必要全開在公網上。
         買到的機器不是 GT06 時，把這行換成對應協定的埠。 -->
    <entry key='gt06.port'>5023</entry>

    <!-- 網頁管理介面 -->
    <entry key='web.port'>8082</entry>

</properties>
